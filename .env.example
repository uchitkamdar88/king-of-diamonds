# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/king_of_diamonds?schema=public"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Create a Web application OAuth client.
#
# Authorized JavaScript origins:
#   http://localhost:5173
#   https://YOUR-VERCEL-DOMAIN
#
# Authorized redirect URIs (SERVER callback — not the Vite origin):
#   http://localhost:3001/auth/google/callback
#   https://YOUR-API-HOST/auth/google/callback
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# Session cookie signing secret (use a long random string in production)
SESSION_SECRET="change-me-to-a-long-random-string"

# URLs — CLIENT_URL is where users land after Google login (/auth/callback)
CLIENT_URL="http://localhost:5173"
SERVER_URL="http://localhost:3001"
PORT=3001

# Public client env (Vite). NEVER put GOOGLE_CLIENT_SECRET here.
# VITE_SERVER_URL must point at the API host so the session cookie is sent.
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
VITE_SERVER_URL="http://localhost:3001"

# Gameplay
MATCHMAKING_TIMEOUT_MS=20000
CHOICE_TIME_MS=15000
RECONNECT_GRACE_MS=30000
CALCULATION_DURATION_MS=8000
ELIMINATION_DURATION_MS=4500
RESULT_DURATION_MS=5000

# Development only — set to "true" to enable a local test login (never enable in production)
DEV_AUTH="false"
