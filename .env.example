# ─────────────────────────────────────────────────────────────
# Server environment variables (.env at monorepo root)
# Used by Node.js / Express / Prisma
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Local (matches docker-compose.yml defaults):
DATABASE_URL="postgresql://kod:kod@localhost:5432/king_of_diamonds?schema=public"
# Production (Render Postgres, Neon, Supabase, etc.):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/king_of_diamonds?schema=public&sslmode=require"

# ─── Google OAuth ───────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
# Create a "Web application" OAuth 2.0 Client.
#
# Authorized JavaScript origins:
#   http://localhost:5173
#   https://YOUR-VERCEL-PROJECT.vercel.app
#
# Authorized redirect URIs (SERVER callback):
#   http://localhost:3001/auth/google/callback
#   https://YOUR-VERCEL-PROJECT.vercel.app/auth/google/callback
#
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# ─── Session ────────────────────────────────────────────────
# Use a long random string in production (min 32 chars)
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ─── URLs ───────────────────────────────────────────────────
# CLIENT_URL: where users land after Google login (/auth/callback)
#   Local:      http://localhost:5173
#   Production: https://YOUR-VERCEL-PROJECT.vercel.app
CLIENT_URL="http://localhost:5173"

# SERVER_URL: base URL of the API (used for OAuth callback construction)
#   Local:      http://localhost:3001
#   Production: https://YOUR-VERCEL-PROJECT.vercel.app  (same domain as client on Vercel)
SERVER_URL="http://localhost:3001"
PORT=3001

# ─── Frontend (Vite) ────────────────────────────────────────
# These VITE_* vars are embedded into the browser bundle.
# NEVER put GOOGLE_CLIENT_SECRET here.
# In production on Vercel services, leave VITE_SERVER_URL empty so the
# browser makes same-origin requests — Vercel edge rewrites route them to
# the server service automatically. Only set it if you run the server on a
# different domain (e.g. a separate Render deployment).
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
# VITE_SERVER_URL=   # leave empty for same-origin (Vercel services); set to http://localhost:3001 for local dev with Vite proxy

# ─── Gameplay timings ───────────────────────────────────────
MATCHMAKING_TIMEOUT_MS=20000
CHOICE_TIME_MS=15000
RECONNECT_GRACE_MS=30000
CALCULATION_DURATION_MS=8000
ELIMINATION_DURATION_MS=4500
RESULT_DURATION_MS=5000

# ─── Development only ───────────────────────────────────────
# Set to "true" to enable Dev Player login buttons (never enable in production)
# Forced off when NODE_ENV=production regardless of this value.
DEV_AUTH="false"
